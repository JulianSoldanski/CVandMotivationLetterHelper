GEMINI_API_KEY=your_gemini_api_key_here
# Optional: override model name (default: gemini-3-flash-preview)
# GEMINI_MODEL=gemini-3-flash-preview

# Optional: serve the bundled Max-Mustermann demo profile instead of your
# real data. When enabled, the app uses an isolated workspace at
# data/.demo/ (seeded once from examples/demo/) so screencasts and live
# demos never touch your real profile, projects, settings, or tracker.
# Restart the app after toggling. Accepted truthy values: 1, true, yes, on.
# DEMO_MODE=1
